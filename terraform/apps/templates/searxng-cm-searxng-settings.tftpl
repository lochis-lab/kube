apiVersion: v1
kind: ConfigMap
metadata:
  name: searxng-settings
  namespace: searxng
data:
  settings.yml: "use_default_settings:\n  engines:\n    keep_only:\n      - bing \
    \         # works via datacenter IPs (verified 200)\n      - google        # 302s\
    \ but usually parseable; drop if captcha-y\n      - mojeek        # crawler-owned\
    \ index, proxy-friendly\n      - wikipedia     # if still timing out via proxy,\
    \ remove this line\n# NOTE: default search category is \"web\" in this SearXNG\
    \ version but the\n# kept engines are tagged \"general\" only \u2192 zero engines\
    \ selected \u2192\n# empty results with NO unresponsive_engines. Re-tag into both:\n\
    engines:\n  - name: bing\n    disabled: false    # listed engines default to disabled\
    \ \u2014 must flip\n    categories: [general, web]\n  - name: google\n    disabled:\
    \ false\n    categories: [general, web]\n  - name: mojeek\n    disabled: false\n\
    \    categories: [general, web]\n  - name: wikipedia\n    disabled: false\n  \
    \  categories: [general, web]\nserver:\n  secret_key: \"${searxng_secret}\" \
    \ # rendered at apply from atlantis-app-vars\n  limiter: false            # cluster-internal;\
    \ no bot protection needed\n  image_proxy: false\nsearch:\n  formats:\n    - html\n\
    \    - json                  # REQUIRED for Firecrawl (disabled by default)\n\
    \  safe_search: 0\n  autocomplete: \"\"\n# Route ALL engine queries through webshare\
    \ (verified: CONNECT works,\n# bing/ddg/marginalia respond fine; google 302s datacenter\
    \ IPs as usual).\n# Rotating gateway \u2192 new exit IP per engine request.\n\
    outgoing:\n  proxies:\n    all://:\n      - ${webshare_proxy_url}  # rendered\
    \ at apply from atlantis-app-vars\n# user-agent unblocked: searxng sends its own\
    \ UA per engine by default;\n# engines accept it \u2014 leave as-is unless results\
    \ thin out.\n"
