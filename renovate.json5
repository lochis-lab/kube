{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'America/New_York',
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^terraform/apps/.*\\.tf$/',
      ],
      matchStrings: [
        'image\\s*=\\s*"(?<depName>[^@"]+)@(?<currentDigest>sha256:[a-f0-9]+)"',
        'image\\s*=\\s*"(?<depName>[^:"]+):(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      matchDatasources: [
        'docker',
      ],
      enabled: false,
      matchPackageNames: [
        '/^ghcr\\.io/lochis//',
      ],
    },
    {
      matchManagers: [
        'helm-values',
        'custom.regex',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      groupName: 'apps patch bumps',
    },
  ],
}
