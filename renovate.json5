{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Hosted Renovate (GitHub App) — no platform/repositories keys (self-hosted only)
  "extends": ["config:recommended"],
  "timezone": "America/New_York",
  // Apps are pure typed HCL now — the kubernetes manager only reads YAML, so
  // image = "..." in .tf needs a regex manager. Covers both tag and digest pins.
  "regexManagers": [
    {
      "fileMatch": ["^terraform/apps/.*\\.tf$"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\"",
        "image\\s*=\\s*\"(?<depName>[^:\"]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["^ghcr\\.io/lochis/"],
      "enabled": false
    },
    {
      "matchManagers": ["helm-values", "regex"],
      "matchUpdateTypes": ["patch"],
      "groupName": "apps patch bumps"
    }
  ]
}
