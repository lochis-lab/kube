{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Hosted Renovate (GitHub App) — no platform/repositories keys (self-hosted only)
  "extends": ["config:recommended"],
  "schedule": ["every 6 hours"],
  "timezone": "America/New_York",
  "kubernetes": { "fileMatch": ["(^|/)apps/.*\\.ya?ml$"] },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["^ghcr\\.io/lochis/"],
      "enabled": false
    },
    {
      "matchManagers": ["kubernetes", "helm-values"],
      "matchUpdateTypes": ["patch"],
      "groupName": "apps patch bumps"
    }
  ]
}
