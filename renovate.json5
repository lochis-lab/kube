{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'America/New_York',
  // Rebase any open PR as soon as main moves (not only on conflict) — keeps
  // Atlantis's `mergeable, undiverged` apply requirements satisfied without
  // manual rebases. Overrides config:recommended's `rebaseWhen: auto`.
  rebaseWhen: 'behind-base-branch',
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^terraform/apps/.*\\.tf$/',
      ],
      matchStrings: [
        'image\\s*=\\s*"(?<depName>[^@"]+)@(?<currentDigest>sha256:[a-f0-9]+)"',
        'image\\s*=\\s*"(?<depName>[^:"]+):(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      matchDatasources: [
        'docker',
      ],
      enabled: false,
      matchPackageNames: [
        '/^ghcr\\.io/lochis//',
      ],
    },
    {
      matchManagers: [
        'helm-values',
        'custom.regex',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      groupName: 'apps patch bumps',
    },
    {
      // Stateful singletons on PVCs: a major bump is a data migration
      // (pg_dump/restore), never an image tag swap — don't propose it.
      // Redis is EXEMPT: RDB format is major-compatible, tag+restart is safe
      // (see docs/major-db-upgrades.md). Discovery for pinned majors:
      // .github/workflows/db-major-watch.yml opens an issue.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/^docker\\.io\\/library\\/(postgres|mongo|mariadb|mysql)/',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
  ],
}
